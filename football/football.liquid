<div class="layout layout--col" style="background:#000;color:#fff;font-family:'Courier New',monospace;padding:12px 16px;justify-content:flex-start;gap:0;">
<div style="width:100%;display:flex;justify-content:space-between;border-bottom:4px solid #fff;padding-bottom:6px;font-size:28px;font-weight:bold;">
<span>302 FOOTBALL RESULTS</span><span>{{ page_label | default: '1/1' | escape }}</span>
</div>
<div style="width:100%;display:flex;justify-content:space-between;font-size:15px;padding:6px 0;">
<span>MEN'S FOOTBALL · COMPLETED MATCHES</span><span>{{ updated | escape }}</span>
</div>
<table style="width:100%;border-collapse:collapse;table-layout:fixed;font-family:inherit;font-size:20px;color:#fff;">
<colgroup><col style="width:38%;"><col style="width:11%;"><col style="width:38%;"><col style="width:13%;"></colgroup>
<tbody>
{% for row in lines %}
{% if row.kind == 'heading' %}
<tr><td colspan="4" style="background:#fff;color:#000;font-size:17px;font-weight:bold;padding:2px 5px;line-height:21px;">{{ row.text | escape }}</td></tr>
{% else %}
<tr style="height:23px;">
<td style="padding:1px 4px;text-align:left;font-size:18px;white-space:nowrap;overflow:hidden;">{{ row.home | escape }}</td>
<td style="padding:1px 0;text-align:center;font-weight:bold;">{{ row.home_score }}-{{ row.away_score }}</td>
<td style="padding:1px 4px;text-align:left;font-size:18px;white-space:nowrap;overflow:hidden;">{{ row.away | escape }}</td>
<td style="padding:1px 0;text-align:right;font-size:14px;">{{ row.note | escape }}</td>
</tr>
{% endif %}
{% endfor %}
</tbody></table>
<div style="width:100%;font-size:16px;padding-top:4px;">{{ message | escape }}</div>
<div style="width:100%;margin-top:auto;border-top:2px solid #fff;padding-top:5px;font-size:14px;display:flex;justify-content:space-between;">
<span>{{ source | escape }} · FT / AET / PENS</span><span>{{ warning | default: 'LATEST RESULTS' | escape }}</span>
</div>
</div>