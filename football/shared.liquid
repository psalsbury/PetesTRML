<style>
.petes-football.layout { height:100%; justify-content:flex-start; }
.petes-football, .petes-football span { font-family:"Courier New",monospace; }
.petes-football .pf-head { border-bottom:3px solid currentColor; }
.petes-football .pf-results { flex:1; min-height:0; overflow:hidden; }
.petes-football .pf-table { table-layout:fixed; }
.petes-football .pf-table td { color:inherit; border:0; }
.petes-football .pf-team { width:37%; }
.petes-football .pf-score { width:16%; }
.petes-football .pf-note { width:10%; }
.petes-football .pf-heading { background:#fff; color:#000; }
.petes-football .pf-foot { border-top:2px solid currentColor; flex-shrink:0; }
</style>

{% template football_results %}
{% assign team_type = 'text--base lg:text--large' %}
{% assign table_type = 'table--base lg:table--large' %}
{% if size_class contains 'narrow' or size_class contains 'short' %}
  {% assign team_type = 'text--small lg:text--base' %}
  {% assign table_type = 'table--xsmall lg:table--base' %}
{% endif %}
<div class="petes-football layout layout--col layout--top bg--black text--white gap--small p--2">
  <div class="pf-head flex flex--row flex--between w--full pb--1">
    <span class="text--large lg:text--xlarge portrait:text--large text--bold text--white">302 FOOTBALL</span>
    <span class="text--small lg:text--base text--white">RESULTS {{ pagination | default: '1/1' | escape }}</span>
  </div>
  <div class="flex flex--row flex--between w--full">
    <span class="text--small lg:text--base text--white">MEN · FULL TIME</span>
    <span class="text--small lg:text--base text--white">{{ checked | escape }}</span>
  </div>
  <div class="pf-results w--full">
    <table class="pf-table table {{ table_type }} w--full"
      data-table-limit="true"
      data-table-max-height="auto"
      data-table-overflow-counter="false">
      <colgroup>
        <col class="pf-team"><col class="pf-score">
        <col class="pf-team"><col class="pf-note">
      </colgroup>
      <tbody>
        {% for row in result_lines limit: row_limit %}
          {% if row.kind == 'heading' %}
            {% unless forloop.last %}
              <tr>
                <td colspan="4" class="pf-heading text--left">
                  <span class="text--small lg:text--base text--black text--bold" data-clamp="1">{{ row.text | escape }}</span>
                </td>
              </tr>
            {% endunless %}
          {% else %}
            <tr>
              <td class="text--left"><span class="{{ team_type }} text--white" data-clamp="1">{{ row.home | escape }}</span></td>
              <td class="text--center"><span class="{{ team_type }} text--white text--bold">{{ row.home_score }}-{{ row.away_score }}</span></td>
              <td class="text--left"><span class="{{ team_type }} text--white" data-clamp="1">{{ row.away | escape }}</span></td>
              <td class="text--right"><span class="text--small lg:text--base text--white" data-clamp="1">{{ row.note | escape }}</span></td>
            </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
    {% if result_lines == empty or result_lines == nil %}
      <div class="description text--white">No completed results available.</div>
    {% endif %}
  </div>
  <div class="pf-foot w--full pt--1">
    <span class="text--small lg:text--base text--white">{{ feed_warning | default: 'BBC Sport · FT / AET / PENS' | escape }}</span>
  </div>
</div>
{% endtemplate %}
